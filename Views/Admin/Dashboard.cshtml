@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="mb-4">
        <h2>Admin Dashboard</h2>
        <p class="text-muted mb-0">
            Pearls & More Bridal Fashion Rental Management System
        </p>
    </div>

    <!-- MANAGEMENT -->
    <div class="row g-3 mb-4">

        <div class="col-12">
            <div class="card border bg-white p-4">

                <h5>Management</h5>

                <p class="text-muted">
                    Use these sections to manage the rental system.
                </p>

                <div class="row g-2">

                    <!-- ITEMS -->
                    <div class="col-md-6">
                        <a asp-controller="Item"
                           asp-action="Index"
                           class="btn btn-outline-dark w-100">
                            Manage Items
                        </a>
                    </div>

                    <!-- CATEGORIES -->
                    <div class="col-md-6">
                        <a asp-controller="Category"
                           asp-action="Index"
                           class="btn btn-outline-dark w-100">
                            Manage Categories
                        </a>
                    </div>

                    <!-- BOOKINGS / RENTALS -->
                    <div class="col-md-6">
                        <a asp-controller="Borrow"
                           asp-action="Index"
                           class="btn btn-outline-dark w-100">
                            Bookings / Rentals
                        </a>
                    </div>

                    <!-- PAYMENTS -->
                    <div class="col-md-6">
                        <a asp-controller="Payment"
                           asp-action="Index"
                           class="btn btn-outline-dark w-100">
                            Payments
                        </a>
                    </div>

                    <!-- REPORTS -->
                    <div class="col-md-6">
                        <a asp-controller="Report"
                           asp-action="Index"
                           class="btn btn-outline-dark w-100">
                            Reports
                        </a>
                    </div>

                    <!-- CHANGE PASSWORD -->
                    <div class="col-md-6">
                        <a asp-controller="Admin"
                           asp-action="ChangePassword"
                           class="btn btn-outline-dark w-100">
                            Change Password
                        </a>
                    </div>

                </div>

            </div>
        </div>

    </div>


    <!-- CATEGORY INVENTORY -->
    <div class="card border bg-white p-4">

        <h5>Category Inventory</h5>

        <p class="text-muted small">
            Each category should contain at least 15 items
            for your capstone requirement.
        </p>

        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="table-light">

                    <tr>
                        <th>Category</th>
                        <th>Items</th>
                        <th>Minimum</th>
                        <th>Status</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var category in ViewBag.CategoryInventory)
                    {
                        <tr>

                            <td>
                                @category.CatName
                            </td>

                            <td>
                                @category.Count
                            </td>

                            <td>
                                15
                            </td>

                            <td>

                                @if (category.Count >= 15)
                                {
                                    <span class="badge bg-success">
                                        Complete
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Need @(15 - category.Count)
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>