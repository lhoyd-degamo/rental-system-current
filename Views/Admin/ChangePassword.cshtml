@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-5">

    <!-- BACK TO DASHBOARD -->
    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="btn btn-outline-secondary mb-3">
        Back
    </a>

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card border bg-white p-4">

                <h2>
                    Change Password
                </h2>

                <p class="text-muted">
                    Update the admin account password.
                </p>


                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }


                <form asp-action="ChangePassword"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="mb-3">

                        <label class="form-label">
                            Current Password
                        </label>

                        <input type="password"
                               name="currentPassword"
                               class="form-control"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            New Password
                        </label>

                        <input type="password"
                               name="newPassword"
                               class="form-control"
                               minlength="6"
                               required />

                    </div>


                    <div class="mb-4">

                        <label class="form-label">
                            Confirm New Password
                        </label>

                        <input type="password"
                               name="confirmPassword"
                               class="form-control"
                               minlength="6"
                               required />

                    </div>


                    <button type="submit"
                            class="btn btn-dark">
                        CHANGE PASSWORD
                    </button>

                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="btn btn-outline-secondary">
                        CANCEL
                    </a>

                </form>

            </div>

        </div>

    </div>

</div>