@model CRUD.Models.Borrow
@using CRUD.Models
@{
    ViewData["Title"] = "Book Item";
    var item = ViewBag.Item as Item;
    var image = item == null ? "/Images/gown4.jpg" : $"/Images/Items/{item.CatID}/{item.ItemCode}.jpg";
    var fallback = item != null && ((item.Category?.CatName ?? "").ToLower().Contains("suit") ||
                   (item.Category?.CatName ?? "").ToLower().Contains("tux") ||
                   (item.Category?.CatName ?? "").ToLower().Contains("barong"))
        ? "/Images/suit4.jpg"
        : "/Images/gown4.jpg";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border bg-white">
                <div class="row g-0">
                    <div class="col-md-5">
                        <img src="@image" alt="@item?.ItemName" style="width:100%;height:500px;object-fit:cover;" onerror="this.onerror=null;this.src='@fallback';" />
                    </div>
                    <div class="col-md-7 p-4">
                        <h2>Book Item</h2>
                        <h4 class="mt-3">@item?.ItemName</h4>
                        <p class="text-muted">@item?.Category?.CatName · Size @item?.Size</p>
                        <h5>₱@item?.Amount.ToString("N2")</h5>

                        <hr />

                        <form asp-action="Book" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <input type="hidden" asp-for="ItemID" />

                            <div class="mb-3">
                                <label asp-for="BorrowDate" class="form-label">Borrow Date</label>
                                <input asp-for="BorrowDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="BorrowDate" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ReturnDate" class="form-label">Expected Return Date</label>
                                <input asp-for="ReturnDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ReturnDate" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="IDType" class="form-label">Valid ID Type</label>
                                    <select asp-for="IDType" class="form-select">
                                        <option value="">Select ID</option>
                                        <option>National ID</option>
                                        <option>Driver's License</option>
                                        <option>Passport</option>
                                        <option>UMID</option>
                                        <option>School ID</option>
                                        <option>Other</option>
                                    </select>
                                    <span asp-validation-for="IDType" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="IDNumber" class="form-label">ID Number</label>
                                    <input asp-for="IDNumber" class="form-control" />
                                    <span asp-validation-for="IDNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="alert alert-light border">
                                Online booking only. Payment is made physically at the boutique.
                            </div>

                            <button type="submit" class="btn btn-dark w-100">CONFIRM BOOKING</button>
                            <a asp-controller="Home" asp-action="CustomerDashboard" class="btn btn-outline-secondary w-100 mt-2">CANCEL</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
