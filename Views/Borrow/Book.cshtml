@model CRUD.Models.Borrow
@using CRUD.Models

@{
    ViewData["Title"] = "Book";

    var items =
        ViewBag.Items as IEnumerable<Item>
        ?? Enumerable.Empty<Item>();
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="mb-4">

        <div style="
            color:#D184A2;
            letter-spacing:3px;
            font-size:12px;">
            ADMIN
        </div>

        <h1 style="
            font-family:'Playfair Display',serif;">
            Create Booking
        </h1>

        <p class="text-muted">
            Reserve an item for a customer.
            Payment is made physically at the boutique.
        </p>

    </div>


    <!-- MAIN CARD -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Book"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- VALIDATION -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- ================================================= -->
                <!-- CUSTOMER -->
                <!-- ================================================= -->

                <h5>
                    Customer
                </h5>

                <hr />


                <div class="row">

                    <!-- NAME -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="NewCustomerName"
                               class="form-label">
                            Name
                        </label>

                        <input asp-for="NewCustomerName"
                               class="form-control" />

                        <span asp-validation-for="NewCustomerName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="NewCustomerEmail"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="NewCustomerEmail"
                               type="email"
                               class="form-control" />

                        <span asp-validation-for="NewCustomerEmail"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PHONE -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="NewCustomerPhone"
                               class="form-label">
                            Phone
                        </label>

                        <input asp-for="NewCustomerPhone"
                               class="form-control" />

                        <span asp-validation-for="NewCustomerPhone"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ADDRESS -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="NewCustomerAddress"
                               class="form-label">
                            Address
                        </label>

                        <input asp-for="NewCustomerAddress"
                               class="form-control" />

                        <span asp-validation-for="NewCustomerAddress"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ID TYPE -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="NewCustomerIDType"
                               class="form-label">
                            ID Type
                        </label>

                        <select asp-for="NewCustomerIDType"
                                class="form-select">

                            <option value="">
                                Select ID
                            </option>

                            <option value="National ID">
                                National ID
                            </option>

                            <option value="Driver's License">
                                Driver's License
                            </option>

                            <option value="Passport">
                                Passport
                            </option>

                            <option value="UMID">
                                UMID
                            </option>

                            <option value="School ID">
                                School ID
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                        <span asp-validation-for="NewCustomerIDType"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ID NUMBER -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="NewCustomerIDNumber"
                               class="form-label">
                            ID Number
                        </label>

                        <input asp-for="NewCustomerIDNumber"
                               class="form-control" />

                        <span asp-validation-for="NewCustomerIDNumber"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BOOKING ITEMS -->
                <!-- ================================================= -->

                <h5 class="mt-3">
                    Booking Items
                </h5>

                <hr />


                <div class="row">

                    @if (items.Any())
                    {
                        foreach (var item in items)
                        {
                            <div class="col-md-6 col-lg-4 mb-2">

                                <label class="border rounded p-3 w-100"
                                       style="cursor:pointer;">

                                    <input type="checkbox"
                                           name="SelectedItemIDs"
                                           value="@item.ItemID"
                                           class="me-2" />

                                    <strong>
                                        @item.ItemName
                                    </strong>

                                    <br />

                                    <small class="text-muted">

                                        @item.Category?.CatName
                                        ·
                                        @item.Size
                                        ·
                                        ₱@item.Amount.ToString("N2")
                                        ·
                                        Stock @item.Quantity

                                    </small>

                                </label>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">

                            <div class="alert alert-warning">
                                No available items are currently
                                available for booking.
                            </div>

                        </div>
                    }

                </div>


                <!-- ================================================= -->
                <!-- DATES -->
                <!-- ================================================= -->

                <div class="row mt-3">

                    <!-- BORROW DATE -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="BorrowDate"
                               class="form-label">
                            Borrow Date
                        </label>

                        <input asp-for="BorrowDate"
                               type="date"
                               class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="BorrowDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- RETURN DATE -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="ReturnDate"
                               class="form-label">
                            Return Date
                        </label>

                        <input asp-for="ReturnDate"
                               type="date"
                               class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="ReturnDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- STATUS -->
                <input type="hidden"
                       asp-for="Status"
                       value="Booked" />


                <!-- INFORMATION -->
                <div class="alert alert-light border mt-2">

                    <strong>Booking</strong>

                    <br />

                    This creates a booking only.
                    The item's stock will not be reduced
                    until the customer actually rents the item.

                </div>


                <!-- BUTTONS -->

                <button type="submit"
                        class="btn"
                        style="
                            background:black;
                            color:white;">

                    SAVE BOOKING

                </button>


                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">

                    CANCEL

                </a>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}