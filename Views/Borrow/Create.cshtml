@model CRUD.Models.Borrow
@using CRUD.Models
@{
    ViewData["Title"] = "Create Physical Rental";
    var items = ViewBag.Items as IEnumerable<Item> ?? Enumerable.Empty<Item>();
}
<div class="container py-4">
    <div class="mb-4"><div style="color:#D184A2;letter-spacing:3px;font-size:12px;">ADMIN</div><h1 style="font-family:'Playfair Display',serif;">Create Physical Rental</h1><p class="text-muted">Use this form only when the customer is physically at the boutique.</p></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <h5>Customer</h5><hr />
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="NewCustomerName" class="form-label">Name</label><input asp-for="NewCustomerName" class="form-control" /><span asp-validation-for="NewCustomerName" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="NewCustomerEmail" class="form-label">Email</label><input asp-for="NewCustomerEmail" type="email" class="form-control" /><span asp-validation-for="NewCustomerEmail" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="NewCustomerPhone" class="form-label">Phone</label><input asp-for="NewCustomerPhone" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="NewCustomerAddress" class="form-label">Address</label><input asp-for="NewCustomerAddress" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="IDType" class="form-label">ID Type</label><select asp-for="IDType" class="form-select"><option value="">Select ID</option><option>National ID</option><option>Driver's License</option><option>Passport</option><option>UMID</option><option>School ID</option><option>Other</option></select></div>
            <div class="col-md-6 mb-3"><label asp-for="IDNumber" class="form-label">ID Number</label><input asp-for="IDNumber" class="form-control" /></div>
        </div>
        <h5 class="mt-3">Rental Items</h5><hr />
        <div class="row">
            @foreach (var item in items)
            {
                <div class="col-md-6 col-lg-4 mb-2"><label class="border rounded p-3 w-100"><input type="checkbox" name="SelectedItemIDs" value="@item.ItemID" class="me-2" /> <strong>@item.ItemName</strong><br /><small class="text-muted">@item.Category?.CatName · @item.Size · ₱@item.Amount.ToString("N2") · Stock @item.Quantity</small></label></div>
            }
        </div>
        <div class="row mt-3"><div class="col-md-6 mb-3"><label asp-for="BorrowDate" class="form-label">Borrow Date</label><input asp-for="BorrowDate" type="date" class="form-control" /><span asp-validation-for="BorrowDate" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="ReturnDate" class="form-label">Return Date</label><input asp-for="ReturnDate" type="date" class="form-control" /><span asp-validation-for="ReturnDate" class="text-danger"></span></div></div>
        <input type="hidden" asp-for="Status" value="Borrowed" />
        <button type="submit" class="btn" style="background:#D184A2;color:white;">SAVE PHYSICAL RENTAL</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">CANCEL</a>
    </form></div></div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
