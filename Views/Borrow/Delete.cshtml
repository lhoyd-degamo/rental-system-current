@model CRUD.Models.Borrow

@{
    ViewData["Title"] = "Delete Borrow";
}

<h2>Delete Borrow</h2>

<h4 class="text-danger">Are you sure you want to delete this borrow record?</h4>
<hr />

<dl class="row">

    <dt class="col-sm-3">
        Customer
    </dt>
    <dd class="col-sm-9">
        @Model.Customer?.CustomerName
    </dd>

    <dt class="col-sm-3">
        Item
    </dt>
    <dd class="col-sm-9">
        @Model.Item?.ItemName
    </dd>

    <dt class="col-sm-3">
        Size
    </dt>
    <dd class="col-sm-9">
        @Model.Item?.Size
    </dd>

    <dt class="col-sm-3">
        Borrow Date
    </dt>
    <dd class="col-sm-9">
        @Model.BorrowDate.ToString("MM/dd/yyyy")
    </dd>

    <dt class="col-sm-3">
        Return Date
    </dt>
    <dd class="col-sm-9">
        @Model.ReturnDate.ToString("MM/dd/yyyy")
    </dd>

    <dt class="col-sm-3">
        Quantity
    </dt>
    <dd class="col-sm-9">
        @Model.Quantity
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>
    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="BorrowID" />

    <input type="submit"
           value="Delete"
           class="btn btn-sm me-2"
           style="background-color:#C76C8C; color:white; border:none; border-radius:8px; padding:8px 18px;" />

    <a asp-action="Index"
       class="btn btn-sm"
       style="background-color:#D184A2; color:white; border:none; border-radius:8px; padding:8px 18px; text-decoration:none;">
        Back to List
    </a>
</form>