@model IEnumerable<CRUD.Models.Borrow>

@{
    ViewData["Title"] = "Bookings and Rentals";
}

<div class="container-fluid py-4">

    <!-- BACK -->
    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="btn btn-outline-secondary mb-3">
        Back
    </a>


    <!-- HEADER -->
    <div class="d-flex justify-content-between
                align-items-center
                flex-wrap
                gap-2
                mb-4">

        <div>

            <div style="
                color:#D184A2;
                letter-spacing:3px;
                font-size:12px;">
                ADMIN
            </div>

            <h2 style="
                font-family:'Playfair Display',serif;">
                Bookings and Rentals
            </h2>

            <p class="text-muted mb-0">
                Manage bookings, physical rentals and returns.
            </p>

        </div>


        <!-- BUTTONS -->
        <div class="d-flex gap-2">

            <!-- ADD BOOKING -->
            <a asp-action="Book"
               class="btn"
               style="
                   background:black;
                   color:white;">

                ADD BOOKING

            </a>


            <!-- ADD PHYSICAL RENTAL -->
            <a asp-action="Create"
               class="btn btn-dark">

                ADD PHYSICAL RENTAL

            </a>

        </div>

    </div>


    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- INFO -->
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">
            @TempData["Info"]
        </div>
    }


    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- TABLE -->
    <div class="table-responsive bg-white border">

        <table class="table table-bordered
                      table-hover
                      mb-0
                      align-middle">

            <thead class="table-light">

                <tr>

                    <th>Booking</th>

                    <th>Customer</th>

                    <th>Item</th>

                    <th>Category</th>

                    <th>Size</th>

                    <th>Borrow Date</th>

                    <th>Return Date</th>

                    <th>Status</th>

                    <th>Penalty</th>

                    <th>Actions</th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Any())
                {
                    foreach (var borrow in Model)
                    {
                        <tr>

                            <!-- ID -->
                            <td>
                                #@borrow.BorrowID
                            </td>


                            <!-- CUSTOMER -->
                            <td>

                                @borrow.Customer?.CustomerName

                                <br />

                                <small class="text-muted">
                                    @borrow.Customer?.PhoneNumber
                                </small>

                            </td>


                            <!-- ITEM -->
                            <td>

                                @if (borrow.BorrowItems != null &&
                                     borrow.BorrowItems.Any())
                                {
                                    foreach (var bi in borrow.BorrowItems)
                                    {
                                        <div>
                                            @bi.Item?.ItemName
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div>
                                        @borrow.Item?.ItemName
                                    </div>
                                }

                            </td>


                            <!-- CATEGORY -->
                            <td>

                                @if (borrow.BorrowItems != null &&
                                     borrow.BorrowItems.Any())
                                {
                                    foreach (var bi in borrow.BorrowItems)
                                    {
                                        <div>
                                            @bi.Item?.Category?.CatName
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div>
                                        @borrow.Item?.Category?.CatName
                                    </div>
                                }

                            </td>


                            <!-- SIZE -->
                            <td>

                                @if (borrow.BorrowItems != null &&
                                     borrow.BorrowItems.Any())
                                {
                                    foreach (var bi in borrow.BorrowItems)
                                    {
                                        <div>
                                            @bi.Item?.Size
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div>
                                        @borrow.Item?.Size
                                    </div>
                                }

                            </td>


                            <!-- BORROW DATE -->
                            <td>
                                @borrow.BorrowDate.ToString("MM/dd/yyyy")
                            </td>


                            <!-- RETURN DATE -->
                            <td>
                                @borrow.ReturnDate.ToString("MM/dd/yyyy")
                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (borrow.Status == "Booked")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Booked
                                    </span>
                                }
                                else if (borrow.Status == "Borrowed")
                                {
                                    <span class="badge bg-primary">
                                        Borrowed
                                    </span>

                                    @if (borrow.IsOverdue)
                                    {
                                        <div class="text-danger mt-1">
                                            Overdue
                                        </div>
                                    }
                                }
                                else if (borrow.Status == "Returned")
                                {
                                    <span class="badge bg-success">
                                        Returned
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @borrow.Status
                                    </span>
                                }

                            </td>


                            <!-- PENALTY -->
                            <td>

                                @if (borrow.Status == "Returned")
                                {
                                    <span>
                                        See receipt
                                    </span>
                                }
                                else if (borrow.IsOverdue)
                                {
                                    <span>
                                        Late return
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        ₱0.00
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->
                            <td>

                                <div class="d-flex
                                            flex-wrap
                                            gap-1">

                                    <!-- EDIT -->
                                    <a asp-action="Edit"
                                       asp-route-id="@borrow.BorrowID"
                                       class="btn btn-sm btn-outline-secondary">

                                        Edit

                                    </a>


                                    <!-- PAY -->
                                    @if (borrow.Status == "Booked")
                                    {
                                        <a asp-controller="Payment"
                                           asp-action="Create"
                                           asp-route-borrowId="@borrow.BorrowID"
                                           class="btn btn-sm btn-success">

                                            Pay

                                        </a>
                                    }


                                    <!-- RETURN -->
                                    @if (borrow.Status == "Borrowed")
                                    {
                                        <a asp-action="ReturnBorrow"
                                           asp-route-id="@borrow.BorrowID"
                                           class="btn btn-sm btn-warning">

                                            Return

                                        </a>
                                    }


                                    <!-- DELETE -->
                                    <a asp-action="Delete"
                                       asp-route-id="@borrow.BorrowID"
                                       class="btn btn-sm btn-danger">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="10"
                            class="text-center py-4">

                            No bookings or rentals found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>