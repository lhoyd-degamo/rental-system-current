@model List<CRUD.Models.Category>

<div class="text-center mb-5">
    <h2 class="fw-bold">Categories</h2>
    <p class="text-muted">Manage boutique rental Categories</p>
    <hr style="width:120px; margin:auto;">
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Category</a>
</p>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CatID</td>
            <td>@item.CatName</td>

            <td>
                <div class="d-flex justify-content-end">

                    <a asp-action="Details"
                       asp-route-id="@item.CatID"
                       class="btn btn-sm me-2"
                       style="background-color:#6C63FF; color:white; border:none; border-radius:8px; width:80px;">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.CatID"
                       class="btn btn-sm me-2"
                       style="background-color:#D184A2; color:white; border:none; border-radius:8px; width:80px;">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.CatID"
                       class="btn btn-sm"
                       style="background-color:#C76C8C; color:white; border:none; border-radius:8px; width:80px;">
                        Delete
                    </a>

                </div>
            </td>

        </tr>
    }

</table>