@model IEnumerable<CRUD.Models.Category>
@{
    ViewData["Title"] = "Home";
}

<style>
    .home-hero {
        background: #eeeeee;
        min-height: 480px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 50px 20px;
        position: relative;
    }

    .home-hero h1 {
        font-size: 48px;
        font-weight: 600;
    }

    .home-hero p {
        max-width: 650px;
        margin: 15px auto 25px;
        color: #666;
    }

    .home-actions {
        position: absolute;
        top: 20px;
        right: 20px;
    }

    .home-actions a {
        margin-left: 5px;
    }

    .home-section {
        padding: 60px 5%;
        background: #fff;
    }

    .category-card {
        border: 1px solid #ddd;
        background: #fff;
        height: 100%;
    }

    .category-card img {
        width: 100%;
        height: 280px;
        object-fit: cover;
        background: #eee;
    }

    .category-card .content {
        padding: 18px;
    }

    .how-section {
        padding: 60px 5%;
        background: #f5f5f5;
    }

    .step {
        text-align: center;
        padding: 20px;
    }

    .step-number {
        font-weight: bold;
        margin-bottom: 10px;
    }
</style>

<section class="home-hero">
    <div class="home-actions">
        <a asp-controller="Home" asp-action="Customer" class="btn btn-dark">CUSTOMER</a>
        <a asp-controller="Admin" asp-action="Login" class="btn btn-outline-dark">ADMIN</a>
    </div>

    <div>
        <p class="text-uppercase small mb-2">Pearls & More Bridal Fashion</p>
        <h1>Your Perfect Look Awaits</h1>
        <p>
            Browse our clothing collection, make an online reservation,
            and complete your rental and payment at the boutique.
        </p>
        <a href="#categories" class="btn btn-dark">VIEW COLLECTION</a>
    </div>
</section>

<section class="home-section text-center">
    <p class="text-muted mb-2">PEARLS & MORE</p>
    <h2>Our Collection</h2>
    <p class="text-muted">
        Select a category to see the items available for rental.
    </p>

    <div id="categories" class="row g-4 mt-3">
        @if (Model.Any())
        {
            foreach (var category in Model)
            {
                var name = (category.CatName ?? "").ToLower();
                var image = name.Contains("suit") || name.Contains("tux") || name.Contains("barong")
                    ? "/Images/suit4.jpg"
                    : "/Images/gown4.jpg";

                <div class="col-md-6 col-lg-4">
                    <div class="category-card">
                        <img src="@image" alt="@category.CatName" />
                        <div class="content text-start">
                            <h4>@category.CatName</h4>
                            <p class="text-muted">Browse items in this category.</p>
                            <a asp-action="Category"
                               asp-route-id="@category.CatID"
                               class="btn btn-outline-dark">
                                VIEW ITEMS
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-muted">No categories have been added yet.</p>
            </div>
        }
    </div>
</section>

<section class="how-section">
    <div class="container">
        <div class="text-center mb-4">
            <h2>How It Works</h2>
        </div>

        <div class="row">
            <div class="col-md-4 step">
                <div class="step-number">01</div>
                <h4>Browse</h4>
                <p class="text-muted">Choose from the available categories and items.</p>
            </div>

            <div class="col-md-4 step">
                <div class="step-number">02</div>
                <h4>Book Online</h4>
                <p class="text-muted">Reserve your selected item online.</p>
            </div>

            <div class="col-md-4 step">
                <div class="step-number">03</div>
                <h4>Visit & Pay</h4>
                <p class="text-muted">Visit the boutique, pay physically, and receive the rental.</p>
            </div>
        </div>
    </div>
</section>
