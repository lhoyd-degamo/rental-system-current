<div class="container mt-5">

    <div class="text-center my-5">

        <h1 style="
            font-family: 'Playfair Display', serif;
            font-size: 52px;
            font-weight: 700;
            color: #D88CA5;
            letter-spacing: 2px;">

            Pearls &amp; More Bridal Fashion

        </h1>

        <p style="
            font-family: 'Poppins', sans-serif;
            font-size: 18px;
            color: #6c757d;">

            Find the perfect gown or suit for your unforgettable moments.

        </p>

    </div>

    <div class="row">

        <div class="col-md-6">

            <div class="card shadow">

                <img src="~/images/suit4.jpg"
                     class="card-img-top"
                     style="height:350px; object-fit:cover;">

                <div class="card-body text-center">

                    <h3>SUITS</h3>

                    <a asp-controller="Home"
                       asp-action="Suits"
                       class="btn btn-danger">
                        View Collection
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow">

                <img src="~/images/gown4.jpg"
                     class="card-img-top"
                     style="height:350px; object-fit:cover;">

                <div class="card-body text-center">

                    <h3>GOWNS</h3>

                    <a asp-controller="Home"
                       asp-action="Gowns"
                       class="btn btn-danger">
                        View Collection
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>