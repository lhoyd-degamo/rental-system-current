@model IEnumerable<CRUD.Models.Item>

@{
    ViewData["Title"] = ViewBag.CategoryName;
}

<div class="container py-4">

    <div class="mb-4">
        <h1>@ViewBag.CategoryName</h1>
        <p class="text-muted">
            Items in this category.
        </p>
    </div>

    <div class="row g-3">

        @foreach (var item in Model)
        {
            // Use the image uploaded for this item.
            // If no image exists, use the fallback image.
            var image = string.IsNullOrWhiteSpace(item.ImagePath)
                ? "/Images/gown4.jpg"
                : item.ImagePath;

            <div class="col-sm-6 col-lg-4">

                <div class="card border h-100 overflow-hidden">

                    <!-- ITEM IMAGE -->
                    <img src="@image"
                         alt="@item.ItemName"
                         style="
                             width:100%;
                             height:350px;
                             object-fit:cover;
                         "
                         onerror="
                             this.onerror=null;
                             this.src='/Images/gown4.jpg';
                         " />

                    <div class="card-body">

                        <h5>
                            @item.ItemName
                        </h5>

                        <div class="text-muted">
                            @item.Category?.CatName
                        </div>

                        <div class="mt-2">
                            Size:
                            <strong>@item.Size</strong>
                        </div>

                        <div class="mt-2">
                            <strong>
                                ₱@item.Amount.ToString("N2")
                            </strong>
                        </div>

                        <div class="mt-2">

                            @if (item.Quantity > 0 &&
                                 item.Status == "Available")
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>

                                <span class="text-muted small">
                                    Stock: @item.Quantity
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Unavailable
                                </span>
                            }

                        </div>

                        <a asp-action="ItemDetails"
                           asp-route-id="@item.ItemID"
                           class="btn btn-outline-dark mt-3 w-100">

                            VIEW DETAILS

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>