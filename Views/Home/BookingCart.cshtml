@model IEnumerable<CRUD.Models.Item>

@{
    ViewData["Title"] = "Booking Cart";

    var items =
        Model?.ToList()
        ?? new List<CRUD.Models.Item>();

    decimal total =
        items.Sum(i => i.Amount);

    var today =
        DateTime.Today.ToString("yyyy-MM-dd");
}

<style>

    .cart-header {
        background: #f3f3f3;
        border: 1px solid #ddd;
        padding: 35px;
        margin-bottom: 35px;
    }

        .cart-header h1 {
            font-weight: 500;
        }

    .cart-item {
        border: 1px solid #ddd;
        background: #fff;
        margin-bottom: 20px;
    }

    .cart-item-image {
        width: 100%;
        height: 260px;
        object-fit: cover;
        background: #eee;
    }

    .cart-item-body {
        padding: 25px;
    }

    .cart-category {
        font-size: 12px;
        color: #777;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .cart-item-name {
        margin-top: 5px;
        margin-bottom: 10px;
        font-weight: 500;
    }

    .cart-price {
        font-size: 20px;
        font-weight: 600;
    }

    .summary-card {
        border: 1px solid #ddd;
        background: #fff;
        position: sticky;
        top: 20px;
    }

    .summary-header {
        padding: 20px 25px;
        border-bottom: 1px solid #ddd;
    }

    .summary-body {
        padding: 25px;
    }

    .date-label {
        font-weight: 500;
        margin-bottom: 7px;
    }

    .empty-cart {
        border: 1px solid #ddd;
        background: #fafafa;
        padding: 70px 20px;
        text-align: center;
    }

</style>


<div class="container py-5">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="cart-header">

        <div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-3">

            <div>

                <div class="text-muted
                    small
                    text-uppercase
                    mb-2">

                    Pearls & More Bridal Fashion

                </div>

                <h1 class="mb-1">
                    Booking Cart
                </h1>

                <p class="text-muted mb-0">
                    Review all the items you want to book.
                </p>

            </div>


            <a asp-action="CustomerDashboard"
               class="btn btn-outline-dark">

                ← Continue Shopping

            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ERROR -->
    <!-- ===================================================== -->
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger">

            @TempData["CartError"]

        </div>
    }


    <!-- ===================================================== -->
    <!-- EMPTY CART -->
    <!-- ===================================================== -->
    @if (!items.Any())
    {
        <div class="empty-cart">

            <div style="font-size:55px;">
                🛒
            </div>

            <h3 class="mt-3">
                Your Booking Cart is Empty
            </h3>

            <p class="text-muted">
                Click "BOOK ITEM" on the customer dashboard
                to add items here.
            </p>

            <a asp-action="CustomerDashboard"
               class="btn btn-dark mt-2">

                BROWSE ITEMS

            </a>

        </div>
    }
    else
    {

        <div class="row g-4">

            <!-- ================================================= -->
            <!-- CART ITEMS -->
            <!-- ================================================= -->

            <div class="col-lg-8">

                <div class="d-flex
                    justify-content-between
                    align-items-center
                    mb-4">

                    <h3 class="mb-0">
                        Selected Items
                    </h3>

                    <span class="text-muted">
                        @items.Count item(s)
                    </span>

                </div>


                @foreach (var item in items)
                {
                    var image =
                        string.IsNullOrWhiteSpace(
                            item.ImagePath)
                        ? "/Images/gown4.jpg"
                        : item.ImagePath;


                    <div class="cart-item">

                        <div class="row g-0">

                            <!-- IMAGE -->

                            <div class="col-md-5">

                                <img src="@image"
                                     alt="@item.ItemName"
                                     class="cart-item-image"
                                     onerror="
                                this.onerror=null;
                                this.src='/Images/gown4.jpg';
                                " />

                            </div>


                            <!-- DETAILS -->

                            <div class="col-md-7">

                                <div class="cart-item-body">

                                    <div class="cart-category">
                                        @item.Category?.CatName
                                    </div>


                                    <h3 class="cart-item-name">
                                        @item.ItemName
                                    </h3>


                                    <p class="text-muted">
                                        @item.Description
                                    </p>


                                    <div class="mb-2">

                                        <span class="text-muted">
                                            Size:
                                        </span>

                                        <strong>
                                            @item.Size
                                        </strong>

                                    </div>


                                    <div class="cart-price">
                                        ₱@item.Amount.ToString("N2")
                                    </div>


                                    <div class="mt-2">

                                        <span class="badge bg-success">
                                            Available
                                        </span>

                                    </div>


                                    <!-- REMOVE -->

                                    <a asp-action="RemoveFromCart"
                                       asp-route-id="@item.ItemID"
                                       class="btn btn-sm
                                        btn-outline-danger
                                        mt-4">

                                        REMOVE ITEM

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>


            <!-- ================================================= -->
            <!-- BOOKING SUMMARY -->
            <!-- ================================================= -->

            <div class="col-lg-4">

                <div class="summary-card">

                    <div class="summary-header">

                        <h4 class="mb-0">
                            Booking Details
                        </h4>

                    </div>


                    <div class="summary-body">

                        <!-- ===================================== -->
                        <!-- BORROW DATE -->
                        <!-- ===================================== -->

                        <div class="mb-4">

                            <label for="borrowDate"
                                   class="date-label">

                                Borrow Date

                            </label>


                            <input type="date"
                                   id="borrowDate"
                                   name="borrowDate"
                                   class="form-control"
                                   min="@today"
                                   required
                                   form="bookingForm" />


                            <small class="text-muted">
                                Select the date you will pick up
                                the items.
                            </small>

                        </div>


                        <!-- ===================================== -->
                        <!-- RETURN DATE -->
                        <!-- ===================================== -->

                        <div class="mb-4">

                            <label for="returnDate"
                                   class="date-label">

                                Return Date

                            </label>


                            <input type="date"
                                   id="returnDate"
                                   name="returnDate"
                                   class="form-control"
                                   min="@today"
                                   required
                                   form="bookingForm" />


                            <small class="text-muted">
                                Select the date you will return
                                the items.
                            </small>

                        </div>


                        <hr />


                        <!-- ===================================== -->
                        <!-- ITEMS -->
                        <!-- ===================================== -->

                        <div class="d-flex
                            justify-content-between
                            mb-2">

                            <span>
                                Number of Items
                            </span>

                            <strong>
                                @items.Count
                            </strong>

                        </div>


                        <!-- ===================================== -->
                        <!-- TOTAL -->
                        <!-- ===================================== -->

                        <div class="d-flex
                            justify-content-between
                            mb-4">

                            <span>
                                Total Rental
                            </span>

                            <strong>
                                ₱@total.ToString("N2")
                            </strong>

                        </div>


                        <!-- ===================================== -->
                        <!-- CONFIRM BOOKING -->
                        <!-- ===================================== -->

                        <form id="bookingForm"
                              asp-action="ConfirmBooking"
                              method="post"
                              onsubmit="return confirmBooking();">

                            @Html.AntiForgeryToken()


                            <button type="submit"
                                    class="btn btn-dark w-100">

                                CONFIRM BOOKING

                            </button>

                        </form>


                        <!-- ===================================== -->
                        <!-- CLEAR CART -->
                        <!-- ===================================== -->

                        <a asp-action="ClearCart"
                           class="btn btn-outline-secondary
                            w-100
                            mt-2">

                            CLEAR BOOKING CART

                        </a>

                    </div>

                </div>

            </div>

        </div>

    }

</div>


<script>

    function confirmBooking() {

        const borrowDate =
            document.getElementById("borrowDate").value;

        const returnDate =
            document.getElementById("returnDate").value;


        if (!borrowDate || !returnDate) {

            alert(
                "Please select the borrow date and return date."
            );

            return false;
        }


        if (returnDate <= borrowDate) {

            alert(
                "Return date must be after the borrow date."
            );

            return false;
        }


        return confirm(
            "Do you want to book these items?"
        );
    }

</script>