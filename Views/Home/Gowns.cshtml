@{
    ViewData["Title"] = "Gown Collection";
}

<div class="container mt-5">

    <h2 class="text-center mb-5"> Gown Collection</h2>

    <div class="row">

        <!-- Gown 1 -->
        <div class="col-md-4 mb-4">
