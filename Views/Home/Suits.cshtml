@{
    ViewData["Title"] = "Suit Collection";
}

<div class="container mt-5">

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-secondary">
            ← Back to Home
        </a>
    </div>

    <h2 class="text-center mb-5"> Suit Collection</h2>

    <div class="row">

        <!-- Suit 1 -->
        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 h-100">

                <img src="~/images/suit1.jpg"
                     class="card-img-top"
                     style="height:380px; object-fit:cover;" />

                <div class="card-body text-center">

                    <h4>Classic Black Suit</h4>

                    <p class="text-muted">
                        A timeless black suit perfect for formal occasions.
                    </p>

                    <h5 class="text-primary">₱800</h5>

                    <button class="btn btn-outline-primary">
                        View Details
                    </button>

                </div>

            </div>

        </div>

        <!-- Suit 2 -->
        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 h-100">

                <img src="~/images/suit2.jpg"
                     class="card-img-top"
                     style="height:380px; object-fit:cover;" />

                <div class="card-body text-center">

                    <h4>Gray Formal Suit</h4>

                    <p class="text-muted">
                        Elegant gray suit suitable for weddings and business events.
                    </p>

                    <h5 class="text-primary">₱950</h5>

                    <button class="btn btn-outline-primary">
                        View Details
                    </button>

                </div>

            </div>

        </div>

        <!-- Suit 3 -->
        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 h-100">

                <img src="~/images/suit3.jpg"
                     class="card-img-top"
                     style="height:380px; object-fit:cover;" />

                <div class="card-body text-center">

                    <h4>White Tuxedo</h4>

                    <p class="text-muted">
                        Premium white tuxedo for special celebrations.
                    </p>

                    <h5 class="text-primary">₱1,200</h5>

                    <button class="btn btn-outline-primary">
                        View Details
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>