<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pearls & More</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isHomePage =
        controller == "Home" &&
        action == "Index";
}

@if (!isHomePage)
{
    <button id="sidebarToggle"
            class="toggle-btn"
            type="button">
        ☰
    </button>

    <div id="sidebar"
         class="sidebar">

        <button id="sidebarClose"
                class="close-btn"
                type="button">
            ×
        </button>

        <div class="logo">
            PEARLS & MORE
        </div>

        <hr />

        <div class="menu">

            <a asp-controller="Home"
               asp-action="Index">
                Home
            </a>

            @if (Context.Session.GetString("AdminUser") != null)
            {
                <a asp-controller="Admin"
                   asp-action="Dashboard">
                    Dashboard
                </a>

                <a asp-controller="Item"
                   asp-action="Index">
                    Items
                </a>

                <a asp-controller="Category"
                   asp-action="Index">
                    Categories
                </a>

                <a asp-controller="Borrow"
                   asp-action="Index">
                    Bookings / Rentals
                </a>
                <a asp-controller="Reservation"
                   asp-action="Index">
                    Categories
                </a>
                <a asp-controller="Payment"
                   asp-action="Index">
                    Payments
                </a>

                <!-- REPORTS -->
                <a asp-controller="Report"
                   asp-action="Index">
                    Reports
                </a>

                <a asp-controller="Admin"
                   asp-action="ChangePassword">
                    Change Password
                </a>

                <a asp-controller="Admin"
                   asp-action="Logout">
                    Logout
                </a>
            }
            else if (Context.Session.GetInt32("CustomerID") != null)
            {
                <a asp-controller="Home"
                   asp-action="CustomerDashboard">
                    My Dashboard
                </a>

                <a asp-controller="Home"
                   asp-action="CustomerLogout">
                    Logout
                </a>
            }

        </div>
    </div>
}

<div id="main"
     class="main @(isHomePage ? "home-main" : "")">

    @RenderBody()

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>