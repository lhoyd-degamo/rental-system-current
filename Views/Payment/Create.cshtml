@model CRUD.Models.Borrow
@{
    ViewData["Title"] = "Record Payment";
    var amount = ViewBag.Amount != null ? (decimal)ViewBag.Amount : 0m;
}
<div class="container py-4">
    <div class="mb-4"><div style="color:#D184A2;letter-spacing:3px;font-size:12px;">ADMIN · PHYSICAL PAYMENT</div><h1 style="font-family:'Playfair Display',serif;">Record Payment</h1><p class="text-muted">Confirm the customer's payment received at the boutique.</p></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
        <div class="row g-4">
            <div class="col-lg-7">
                <h5>Order #@Model.BorrowID</h5><hr />
                <div class="row g-3 mb-4"><div class="col-md-6"><small class="text-muted">Customer</small><br /><strong>@Model.Customer?.CustomerName</strong></div><div class="col-md-6"><small class="text-muted">Phone</small><br />@Model.Customer?.PhoneNumber</div><div class="col-md-6"><small class="text-muted">Borrow Date</small><br />@Model.BorrowDate.ToString("MMMM dd, yyyy")</div><div class="col-md-6"><small class="text-muted">Return Date</small><br />@Model.ReturnDate.ToString("MMMM dd, yyyy")</div></div>
                <h5>Rental Items</h5>
                @foreach (var bi in Model.BorrowItems)
                {
                    <div class="border rounded p-3 mb-2 d-flex justify-content-between"><span><strong>@bi.Item?.ItemName</strong><br /><small class="text-muted">@bi.Item?.Category?.CatName · Size @bi.Item?.Size</small></span><strong>₱@(bi.Item?.Amount.ToString("N2"))</strong></div>
                }
            </div>
            <div class="col-lg-5">
                <div class="bg-light rounded p-4"><div class="text-muted">TOTAL TO COLLECT</div><div style="font-size:34px;color:#C76C8C;font-weight:600;">₱@amount.ToString("N2")</div><hr /><div class="mb-3"><strong>Payment method</strong><br />Cash at boutique</div><div class="alert alert-light border">After confirmation, the booking becomes <strong>Borrowed</strong> and inventory is reduced.</div><form asp-action="ConfirmPayment" method="post">@Html.AntiForgeryToken()<input type="hidden" name="borrowId" value="@Model.BorrowID" /><button type="submit" class="btn w-100" style="background:#D184A2;color:white;padding:12px;">CONFIRM CASH PAYMENT</button></form><a asp-controller="Borrow" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">CANCEL</a></div>
            </div>
        </div>
    </div></div>
</div>
