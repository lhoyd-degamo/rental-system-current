@model CRUD.Models.Reservation
@using CRUD.Models

@{
    ViewData["Title"] = "Edit Reservation";

    var items = ViewBag.Items as List<Item>
                ?? new List<Item>();

    var existingItemIDs =
        Model.SelectedItemIDs ?? new List<int>();
}

<style>
    .reservation-page {
        padding: 25px;
        background: #fff;
        min-height: 100vh;
    }

    .page-header {
        background: #D184A2;
        color: white;
        padding: 18px 22px;
        border-radius: 10px;
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 25px;
            font-weight: 600;
        }

        .page-header p {
            margin: 5px 0 0;
            font-size: 14px;
            opacity: .9;
        }

    .section-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 22px;
        box-shadow: 0 2px 7px rgba(0,0,0,.05);
    }

    .section-title {
        font-size: 19px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #444;
    }

    .search-box {
        margin-bottom: 15px;
    }

        .search-box input {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid #ccc;
            border-radius: 7px;
            outline: none;
        }

    .items-table {
        width: 100%;
        border-collapse: collapse;
    }

        .items-table th {
            background: #fafafa;
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
            font-size: 13px;
        }

        .items-table td {
            padding: 12px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        .items-table tr:hover {
            background: #fff8fa;
        }

    .btn-add {
        background: #D184A2;
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-remove {
        background: #dc3545;
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 6px;
        cursor: pointer;
    }

    .selected-empty {
        text-align: center;
        color: #888;
        padding: 20px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        border-radius: 7px;
        padding: 10px 12px;
    }

    .required {
        color: #dc3545;
    }

    .bottom-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    .left-buttons,
    .right-buttons {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .btn-back {
        background: #6c757d;
        color: white;
        padding: 11px 22px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-save {
        background: #D184A2;
        color: white;
        border: none;
        padding: 11px 22px;
        border-radius: 7px;
        font-weight: 600;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 11px 22px;
        border-radius: 7px;
        font-weight: 600;
    }

        .btn-delete:hover {
            background: #bb2d3b;
        }
</style>

<div class="reservation-page">

    <div class="page-header">
        <h2>Edit Reservation #@Model.ReservationID</h2>
        <p>Update the reservation details and selected items.</p>
    </div>

    <form asp-action="Edit"
          method="post"
          id="editReservationForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="ReservationID" />

        <input type="hidden"
               asp-for="CustomerID" />


        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>


        <!-- AVAILABLE ITEMS -->

        <div class="section-card">

            <div class="section-title">
                Available Items
            </div>

            <div class="search-box">

                <input type="text"
                       id="itemSearch"
                       placeholder="Search item code, item name, category, or size..." />

            </div>

            <div class="table-responsive">

                <table class="items-table">

                    <thead>
                        <tr>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Category</th>
                            <th>Size</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in items)
                        {
                            var isSelected =
                                existingItemIDs.Contains(item.ItemID);

                            <tr class="item-row">

                                <td>
                                    @item.ItemCode
                                </td>

                                <td>
                                    @item.ItemName
                                </td>

                                <td>
                                    @(item.Category?.CatName ?? "N/A")
                                </td>

                                <td>
                                    @item.Size
                                </td>

                                <td>
                                    ₱@item.Amount.ToString("N2")
                                </td>

                                <td>
                                    @item.Status
                                </td>

                                <td>

                                    <button type="button"
                                            class="btn-add add-item"
                                            data-id="@item.ItemID"
                                            data-code="@item.ItemCode"
                                            data-name="@item.ItemName"
                                            data-category="@(item.Category?.CatName ?? "N/A")"
                                            data-size="@item.Size"
                                            data-price="@item.Amount.ToString("N2")"
                                        @(isSelected ? "disabled" : "")>

                                        @(isSelected ? "Added" : "Add")

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- SELECTED ITEMS -->

        <div class="section-card">

            <div class="section-title">
                Selected Items
            </div>

            <div class="table-responsive">

                <table class="items-table">

                    <thead>
                        <tr>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Category</th>
                            <th>Size</th>
                            <th>Price</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="selectedItemsBody">

                        <tr>
                            <td colspan="6"
                                class="selected-empty">
                                Loading selected items...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>


        <!-- CUSTOMER -->

        <div class="section-card">

            <div class="section-title">
                Customer Information
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Customer Name
                    </label>

                    <input asp-for="NewCustomerName"
                           value="@Model.Customer?.CustomerName"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label class="form-label">
                        Email
                    </label>

                    <input asp-for="NewCustomerEmail"
                           value="@Model.Customer?.Email"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label class="form-label">
                        Phone Number
                    </label>

                    <input asp-for="NewCustomerPhone"
                           value="@Model.Customer?.PhoneNumber"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label class="form-label">
                        Address
                    </label>

                    <input asp-for="NewCustomerAddress"
                           value="@Model.Customer?.Address"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label asp-for="IDType"
                           class="form-label">
                        ID Type
                    </label>

                    <select asp-for="IDType"
                            class="form-select">

                        <option value="">-- Select ID Type --</option>
                        <option value="PhilID">PhilID</option>
                        <option value="Driver's License">Driver's License</option>
                        <option value="Passport">Passport</option>
                        <option value="UMID">UMID</option>
                        <option value="School ID">School ID</option>
                        <option value="Other">Other</option>

                    </select>

                </div>

                <div class="col-md-6">

                    <label asp-for="IDNumber"
                           class="form-label">
                        ID Number
                    </label>

                    <input asp-for="IDNumber"
                           class="form-control" />

                </div>

            </div>

        </div>


        <!-- RESERVATION -->

        <div class="section-card">

            <div class="section-title">
                Reservation Information
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="StartDate"
                           class="form-label">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label asp-for="EndDate"
                           class="form-label">
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label asp-for="Status"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Completed">Completed</option>

                    </select>

                </div>

                <div class="col-md-6">

                    <label asp-for="Notes"
                           class="form-label">
                        Notes
                    </label>

                    <input asp-for="Notes"
                           class="form-control" />

                </div>

            </div>

        </div>


        <!-- HIDDEN SELECTED ITEMS -->

        <div id="selectedItemInputs"></div>


        <!-- BUTTONS -->

        <div class="bottom-buttons">

            <div class="left-buttons">

                <a asp-action="Index"
                   class="btn-back">
                    ← Back
                </a>

            </div>

            <div class="right-buttons">

                <button type="submit"
                        class="btn-save">
                    Save Changes
                </button>

                <button type="button"
                        class="btn-delete"
                        onclick="confirmDelete()">
                    Delete Reservation
                </button>

            </div>

        </div>

    </form>


    <!-- DELETE FORM -->

    <form id="deleteForm"
          asp-action="DeleteConfirmed"
          method="post"
          style="display:none;">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="ReservationID"
               value="@Model.ReservationID" />

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // ============================================
        // SELECTED ITEMS
        // ============================================

        const selectedItems = new Map();


        // Existing items from database
        @foreach (var item in items.Where(i => existingItemIDs.Contains(i.ItemID)))
        {
                <text>

                    selectedItems.set(
                        "@item.ItemID",
                        {
                            id: "@item.ItemID",
                            code: "@item.ItemCode",
                            name: "@item.ItemName",
                            category: "@(item.Category?.CatName ?? "N/A")",
                            size: "@item.Size",
                            price: "@item.Amount.ToString("N2")"
                        }
                    );

                </text>
        }


        // ============================================
        // SEARCH
        // ============================================

        document.getElementById("itemSearch")
            .addEventListener("input", function () {

                const search =
                    this.value.toLowerCase();

                document.querySelectorAll(".item-row")
                    .forEach(row => {

                        row.style.display =
                            row.innerText
                                .toLowerCase()
                                .includes(search)
                                ? ""
                                : "none";

                    });

            });


        // ============================================
        // ADD ITEM
        // ============================================

        document.querySelectorAll(".add-item")
            .forEach(button => {

                button.addEventListener("click", function () {

                    const id = this.dataset.id;

                    if (selectedItems.has(id))
                        return;

                    selectedItems.set(id, {

                        id: id,

                        code: this.dataset.code,

                        name: this.dataset.name,

                        category: this.dataset.category,

                        size: this.dataset.size,

                        price: this.dataset.price

                    });

                    this.disabled = true;

                    this.innerText = "Added";

                    renderSelectedItems();

                });

            });


        // ============================================
        // RENDER
        // ============================================

        function renderSelectedItems() {

            const tbody =
                document.getElementById(
                    "selectedItemsBody"
                );

            const inputs =
                document.getElementById(
                    "selectedItemInputs"
                );

            tbody.innerHTML = "";

            inputs.innerHTML = "";


            if (selectedItems.size === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="6"
                            class="selected-empty">
                            No items selected.
                        </td>
                    </tr>
                `;

                return;
            }


            selectedItems.forEach(item => {

                tbody.innerHTML += `

                    <tr>

                        <td>${item.code}</td>

                        <td>${item.name}</td>

                        <td>${item.category}</td>

                        <td>${item.size}</td>

                        <td>₱${item.price}</td>

                        <td>

                            <button type="button"
                                    class="btn-remove"
                                    onclick="removeItem('${item.id}')">

                                Remove

                            </button>

                        </td>

                    </tr>
                `;


                inputs.innerHTML += `

                    <input type="hidden"
                           name="SelectedItemIDs"
                           value="${item.id}" />

                `;

            });

        }


        // ============================================
        // REMOVE
        // ============================================

        function removeItem(id) {

            selectedItems.delete(id);

            const button =
                document.querySelector(
                    `.add-item[data-id="${id}"]`
                );

            if (button) {

                button.disabled = false;

                button.innerText = "Add";

            }

            renderSelectedItems();

        }


        // ============================================
        // DELETE
        // ============================================

        function confirmDelete() {

            const confirmed =
                confirm(
                    "Are you sure you want to delete this reservation?"
                );

            if (confirmed) {

                document
                    .getElementById("deleteForm")
                    .submit();

            }

        }


        // Initial render
        renderSelectedItems();

    </script>
}