@model CRUD.Models.Reservation

@{
    ViewData["Title"] = "Add Reservation";

    var availableItems =
        ViewBag.AvailableItems as List<CRUD.Models.Item>
        ?? new List<CRUD.Models.Item>();

    var selectedItemIDs =
        ViewBag.SelectedItemIDs as List<int>
        ?? new List<int>();
}

<style>

    .reservation-page {
        padding: 25px;
    }

    .page-header {
        margin-bottom: 20px;
    }

    .page-title {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        color: #333;
    }

    .card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 17px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #333;
    }

    .search-box {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 15px;
        font-size: 14px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .item-table {
        width: 100%;
        border-collapse: collapse;
    }

        .item-table th {
            background: #fafafa;
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
            font-size: 13px;
        }

        .item-table td {
            padding: 12px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            vertical-align: middle;
        }

        .item-table tr:hover {
            background: #fff8fb;
        }

    .btn-select {
        background: #D184A2;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 6px 12px;
        font-size: 12px;
        cursor: pointer;
    }

        .btn-select:hover {
            background: #b96f8d;
        }

    .btn-remove {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 6px 12px;
        font-size: 12px;
        cursor: pointer;
    }

        .btn-remove:hover {
            background: #bb2d3b;
        }

    .selected-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .selected-table th {
            background: #fafafa;
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
            font-size: 13px;
        }

        .selected-table td {
            padding: 12px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

    .empty-selected {
        text-align: center;
        color: #888;
        padding: 20px;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #444;
        }

    .form-control {
        width: 100%;
        padding: 9px 11px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #D184A2;
        }

    .validation {
        color: #dc3545;
        font-size: 12px;
        margin-top: 4px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-save {
        background: #D184A2;
        color: white;
        border: none;
        padding: 9px 18px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #b96f8d;
        }

    .btn-back {
        background: #6c757d;
        color: white;
        padding: 9px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #5c636a;
            color: white;
        }

    .stock {
        font-weight: 600;
    }

  
    {
        grid-template-columns: 1fr;
    }

    .reservation-page {
        padding: 15px;
    }

    }
</style>


<div class="reservation-page">

    <!-- PAGE HEADER -->

    <div class="page-header">

        <h2 class="page-title">
            Add Reservation
        </h2>

    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <!-- ==========================================================
             AVAILABLE ITEMS
        =========================================================== -->

        <div class="card">

            <div class="card-title">
                Available Items
            </div>


            <input type="text"
                   id="itemSearch"
                   class="search-box"
                   placeholder="Search item name or item code..."
                   onkeyup="searchItems()" />


            <div class="table-wrapper">

                <table class="item-table">

                    <thead>
                        <tr>

                            <th>
                                Item Code
                            </th>

                            <th>
                                Item Name
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Size
                            </th>

                            <th>
                                Price
                            </th>

                            <th>
                                Stock
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>
                    </thead>


                    <tbody id="availableItemsBody">

                        @if (availableItems.Any())
                        {
                            foreach (var item in availableItems)
                            {
                                <tr class="available-item-row"
                                    data-id="@item.ItemID"
                                    data-name="@item.ItemName.ToLower()"
                                    data-code="@item.ItemCode.ToLower()">

                                    <td>
                                        @item.ItemCode
                                    </td>

                                    <td>
                                        @item.ItemName
                                    </td>

                                    <td>
                                        @(item.Category?.CatName ?? "N/A")
                                    </td>

                                    <td>
                                        @item.Size
                                    </td>

                                    <td>
                                        ₱@item.Amount.ToString("N2")
                                    </td>

                                    <td>
                                        <span class="stock">
                                            @item.Quantity
                                        </span>
                                    </td>

                                    <td>

                                        @if (selectedItemIDs.Contains(item.ItemID))
                                        {
                                            <button type="button"
                                                    class="btn-remove"
                                                    onclick="removeItem(@item.ItemID)">
                                                Remove
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn-select"
                                                    onclick="selectItem(@item.ItemID)">
                                                Select
                                            </button>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="empty-selected">

                                    No available items found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- ==========================================================
             SELECTED ITEMS
        =========================================================== -->

        <div class="card">

            <div class="card-title">
                Selected Items
            </div>


            <table class="selected-table">

                <thead>
                    <tr>

                        <th>
                            Item Code
                        </th>

                        <th>
                            Item Name
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Size
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>
                </thead>


                <tbody id="selectedItemsBody">

                    <tr id="noSelectedItems">

                        <td colspan="5"
                            class="empty-selected">

                            No items selected.

                        </td>

                    </tr>

                </tbody>

            </table>

            <div id="hiddenInputs"></div>

            <span asp-validation-for="SelectedItemIDs"
                  class="validation">
            </span>

        </div>


        <!-- ==========================================================
             CUSTOMER INFORMATION
        =========================================================== -->

        <div class="card">

            <div class="card-title">
                Customer Information
            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        Customer Name
                    </label>

                    <input asp-for="NewCustomerName"
                           class="form-control"
                           placeholder="Enter customer name" />

                    <span asp-validation-for="NewCustomerName"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label>
                        Customer Email
                    </label>

                    <input asp-for="NewCustomerEmail"
                           class="form-control"
                           placeholder="Enter customer email" />

                    <span asp-validation-for="NewCustomerEmail"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label>
                        Phone Number
                    </label>

                    <input asp-for="NewCustomerPhone"
                           class="form-control"
                           placeholder="Enter phone number" />

                    <span asp-validation-for="NewCustomerPhone"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label>
                        Address
                    </label>

                    <input asp-for="NewCustomerAddress"
                           class="form-control"
                           placeholder="Enter address" />

                    <span asp-validation-for="NewCustomerAddress"
                          class="validation">
                    </span>

                </div>

            </div>

        </div>


        <!-- ==========================================================
             IDENTIFICATION
        =========================================================== -->

        <div class="card">

            <div class="card-title">
                Identification
            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        ID Type
                    </label>

                    <input asp-for="IDType"
                           class="form-control"
                           placeholder="Example: Driver's License" />

                    <span asp-validation-for="IDType"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label>
                        ID Number
                    </label>

                    <input asp-for="IDNumber"
                           class="form-control"
                           placeholder="Enter ID number" />

                    <span asp-validation-for="IDNumber"
                          class="validation">
                    </span>

                </div>

            </div>

        </div>


        <!-- ==========================================================
             RESERVATION DETAILS
        =========================================================== -->

        <div class="card">

            <div class="card-title">
                Reservation Details
            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label>
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="validation">
                    </span>

                </div>

            </div>


            <div class="form-group">

                <label>
                    Notes
                </label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="3"
                          placeholder="Optional notes">
                </textarea>

            </div>

        </div>


        <!-- ==========================================================
             BUTTONS
        =========================================================== -->

        <div class="form-actions">

            <a asp-action="Index"
               class="btn-back">
                Back
            </a>

            <button type="submit"
                    class="btn-save">
                Save Reservation
            </button>

        </div>

    </form>

</div>


<script>

    // ================================================================
    // SELECTED ITEMS
    // ================================================================

    let selectedItems = [];

    @foreach (var id in selectedItemIDs)
    {
                <text>
                        selectedItems.push(@id);
                </text>
    }


    // ================================================================
    // SELECT ITEM
    // ================================================================

    function selectItem(itemID) {

        if (!selectedItems.includes(itemID)) {

            selectedItems.push(itemID);

        }

        updateSelectedItems();

    }


    // ================================================================
    // REMOVE ITEM
    // ================================================================

    function removeItem(itemID) {

        selectedItems =
            selectedItems.filter(
                id => id !== itemID
            );

        updateSelectedItems();

    }


    // ================================================================
    // UPDATE SELECTED ITEMS
    // ================================================================

    function updateSelectedItems() {

        const selectedBody =
            document.getElementById(
                "selectedItemsBody"
            );

        const hiddenInputs =
            document.getElementById(
                "hiddenInputs"
            );

        selectedBody.innerHTML = "";

        hiddenInputs.innerHTML = "";


        if (selectedItems.length === 0) {

            selectedBody.innerHTML = `
                <tr>
                    <td colspan="5"
                        class="empty-selected">
                        No items selected.
                    </td>
                </tr>
            `;

            updateAvailableButtons();

            return;
        }


        selectedItems.forEach(function (itemID) {

            const row =
                document.querySelector(
                    `.available-item-row[data-id="${itemID}"]`
                );


            if (!row)
                return;


            const cells =
                row.querySelectorAll("td");


            const itemCode =
                cells[0].innerText.trim();

            const itemName =
                cells[1].innerText.trim();

            const category =
                cells[2].innerText.trim();

            const size =
                cells[3].innerText.trim();


            selectedBody.innerHTML += `

                <tr>

                    <td>
                        ${itemCode}
                    </td>

                    <td>
                        ${itemName}
                    </td>

                    <td>
                        ${category}
                    </td>

                    <td>
                        ${size}
                    </td>

                    <td>

                        <button type="button"
                                class="btn-remove"
                                onclick="removeItem(${itemID})">
                            Remove
                        </button>

                    </td>

                </tr>

            `;


            hiddenInputs.innerHTML += `

                <input type="hidden"
                       name="SelectedItemIDs"
                       value="${itemID}" />

            `;

        });


        updateAvailableButtons();

    }


    // ================================================================
    // UPDATE AVAILABLE ITEM BUTTONS
    // ================================================================

    function updateAvailableButtons() {

        document
            .querySelectorAll(
                ".available-item-row"
            )
            .forEach(function (row) {

                const itemID =
                    parseInt(
                        row.dataset.id
                    );


                const button =
                    row.querySelector(
                        "button"
                    );


                if (!button)
                    return;


                if (selectedItems.includes(itemID)) {

                    button.className =
                        "btn-remove";

                    button.innerText =
                        "Remove";

                    button.onclick =
                        function () {
                            removeItem(itemID);
                        };

                }
                else {

                    button.className =
                        "btn-select";

                    button.innerText =
                        "Select";

                    button.onclick =
                        function () {
                            selectItem(itemID);
                        };

                }

            });

    }


    // ================================================================
    // SEARCH ITEMS
    // ================================================================

    function searchItems() {

        const search =
            document
                .getElementById(
                    "itemSearch"
                )
                .value
                .toLowerCase()
                .trim();


        document
            .querySelectorAll(
                ".available-item-row"
            )
            .forEach(function (row) {

                const name =
                    row.dataset.name;

                const code =
                    row.dataset.code;


                if (
                    name.includes(search) ||
                    code.includes(search)
                ) {

                    row.style.display =
                        "";

                }
                else {

                    row.style.display =
                        "none";

                }

            });

    }


    // ================================================================
    // INITIALIZE
    // ================================================================

    updateSelectedItems();

</script>