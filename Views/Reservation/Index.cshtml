@model IEnumerable<CRUD.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<style>
    .reservation-page {
        padding: 25px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .page-title {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        color: #333;
    }

    .btn-add {
        background: #D184A2;
        color: white;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #b96f8d;
            color: white;
        }

    .table-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        overflow-x: auto;
    }

    .reservation-table {
        width: 100%;
        border-collapse: collapse;
    }

        .reservation-table th {
            padding: 14px 16px;
            background: #fafafa;
            border-bottom: 1px solid #e5e5e5;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            color: #333;
            white-space: nowrap;
        }

        .reservation-table td {
            padding: 15px 16px;
            border-bottom: 1px solid #eeeeee;
            font-size: 14px;
            color: #444;
            vertical-align: middle;
        }

        .reservation-table tr:last-child td {
            border-bottom: none;
        }

        .reservation-table tr:hover {
            background: #fff8fb;
        }

    .reservation-id {
        font-weight: 600;
        color: #333;
    }

    .customer-name {
        font-weight: 600;
        color: #333;
    }

    .customer-email {
        margin-top: 3px;
        font-size: 12px;
        color: #777;
    }

    .item-list {
        margin: 0;
        padding-left: 18px;
    }

        .item-list li {
            margin-bottom: 3px;
        }

    .status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 15px;
        background: #e9ecef;
        color: #555;
        font-size: 12px;
        font-weight: 600;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-edit {
        background: #D184A2;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

        .btn-edit:hover {
            background: #b96f8d;
            color: white;
        }

    .btn-borrow {
        background: #198754;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-borrow:hover {
            background: #157347;
        }

    .empty-message {
        text-align: center;
        padding: 35px;
        color: #777;
    }

    

    {
        overflow-x: auto;
    }

    .reservation-table {
        min-width: 850px;
    }

    }
</style>

<div class="reservation-page">

    <!-- Header -->
    <div class="page-header">

        <h2 class="page-title">
            Reservations
        </h2>

        <a asp-action="Create" class="btn-add">
            + ADD RESERVATION
        </a>

    </div>

    <!-- Table -->
    <div class="table-card">

        <table class="reservation-table">

            <thead>
                <tr>
                    <th>Reservation ID</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var reservation in Model)
                    {
                        <tr>

                            <!-- Reservation ID -->
                            <td>
                                <span class="reservation-id">
                                    #@reservation.ReservationID
                                </span>
                            </td>

                            <!-- Customer -->
                            <td>

                                @if (reservation.Customer != null)
                                {
                                    <div class="customer-name">
                                        @reservation.Customer.CustomerName
                                    </div>

                                    <div class="customer-email">
                                        @reservation.Customer.Email
                                    </div>
                                }
                                else
                                {
                                    <div class="customer-name">
                                        Customer #@reservation.CustomerID
                                    </div>
                                }

                            </td>

                            <!-- Items -->
                            <td>

                                @if (reservation.ReservationItems != null &&
                                                        reservation.ReservationItems.Any())
                                {
                                    <ul class="item-list">

                                        @foreach (var reservationItem in reservation.ReservationItems)
                                        {
                                            <li>
                                                @if (reservationItem.Item != null)
                                                {
                                                    @reservationItem.Item.ItemName
                                                }
                                                else
                                                {
                                                    <span>Unknown Item</span>
                                                }
                                            </li>
                                        }

                                    </ul>
                                }
                                else
                                {
                                    <span>No items</span>
                                }

                            </td>

                            <!-- Start Date -->
                            <td>
                                @reservation.StartDate.ToString("MMM dd, yyyy")
                            </td>

                            <!-- End Date -->
                            <td>
                                @reservation.EndDate.ToString("MMM dd, yyyy")
                            </td>

                            <!-- Status -->
                            <td>
                                <span class="status">
                                    @reservation.Status
                                </span>
                            </td>

                            <!-- Actions -->
                            <td>

                                <div class="actions">

                                    <!-- Edit -->
                                    <a asp-action="Edit"
                                       asp-route-id="@reservation.ReservationID"
                                       class="btn-edit">
                                        Edit
                                    </a>

                                    <!-- Borrow -->
                                    @if (reservation.Status != "Borrowed" &&
                                                                reservation.Status != "Cancelled")
                                    {
                                        <form asp-action="Borrow"
                                              asp-route-id="@reservation.ReservationID"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn-borrow"
                                                    onclick="return confirmBorrow();">
                                                Borrow
                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-message">
                            No reservations found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script>

    function confirmBorrow() {

        return confirm(
            "Are you sure you want to borrow all items in this reservation?"
        );

    }

</script>