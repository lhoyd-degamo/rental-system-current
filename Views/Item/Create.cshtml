@model CRUD.Models.Item

@{
    ViewData["Title"] = "Add Item";
}

<div class="container-fluid py-4">

    <!-- BACK BUTTON -->

    <a asp-action="Index"
       class="btn btn-outline-secondary mb-3">
        Back
    </a>


    <!-- MAIN CARD -->

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card border bg-white">

                <div class="card-body p-4">

                    <!-- TITLE -->

                    <h2 class="mb-1">
                        Add Item
                    </h2>

                    <p class="text-muted mb-4">
                        Add an item to your rental inventory.
                    </p>


                    <!-- FORM -->

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()


                        <!-- VALIDATION SUMMARY -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="row g-4">


                            <!-- ================================= -->
                            <!-- LEFT SIDE -->
                            <!-- ================================= -->

                            <div class="col-md-7">


                                <!-- ITEM NAME -->

                                <div class="mb-3">

                                    <label asp-for="ItemName"
                                           class="form-label">
                                        Item Name
                                    </label>

                                    <input asp-for="ItemName"
                                           class="form-control"
                                           placeholder="Enter item name" />

                                    <span asp-validation-for="ItemName"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- DESCRIPTION -->

                                <div class="mb-3">

                                    <label asp-for="Description"
                                           class="form-label">
                                        Description
                                    </label>

                                    <textarea asp-for="Description"
                                              class="form-control"
                                              rows="4"
                                              placeholder="Enter description"></textarea>

                                    <span asp-validation-for="Description"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- RENTAL PRICE -->

                                <div class="mb-3">

                                    <label asp-for="Amount"
                                           class="form-label">
                                        Rental Price
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            ₱
                                        </span>

                                        <input asp-for="Amount"
                                               class="form-control"
                                               type="number"
                                               min="0.01"
                                               step="0.01" />

                                    </div>

                                    <span asp-validation-for="Amount"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- SIZE -->

                                <div class="mb-3">

                                    <label asp-for="Size"
                                           class="form-label">
                                        Size
                                    </label>

                                    <select asp-for="Size"
                                            class="form-select">

                                        <option value="">
                                            Select Size
                                        </option>

                                        <option value="XS">
                                            XS
                                        </option>

                                        <option value="Small">
                                            Small
                                        </option>

                                        <option value="Medium">
                                            Medium
                                        </option>

                                        <option value="Large">
                                            Large
                                        </option>

                                        <option value="XL">
                                            XL
                                        </option>

                                        <option value="XXL">
                                            XXL
                                        </option>

                                    </select>

                                    <span asp-validation-for="Size"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- QUANTITY -->

                                <div class="mb-3">

                                    <label asp-for="Quantity"
                                           class="form-label">
                                        Quantity
                                    </label>

                                    <input asp-for="Quantity"
                                           class="form-control"
                                           type="number"
                                           min="1"
                                           value="1" />

                                    <span asp-validation-for="Quantity"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- CATEGORY -->

                                <div class="mb-3">

                                    <label asp-for="CatID"
                                           class="form-label">
                                        Category
                                    </label>

                                    <select asp-for="CatID"
                                            asp-items="ViewBag.Categories"
                                            class="form-select">

                                        <option value="">
                                            Select Category
                                        </option>

                                    </select>

                                    <span asp-validation-for="CatID"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- ================================= -->
                                <!-- IMAGE UPLOAD -->
                                <!-- ================================= -->

                                <div class="mb-3">

                                    <label for="ImageFile"
                                           class="form-label">
                                        Item Image
                                    </label>

                                    <input type="file"
                                           id="ImageFile"
                                           name="ImageFile"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp" />

                                    <div class="form-text">
                                        JPG, JPEG, PNG or WEBP.
                                        Maximum 5 MB.
                                    </div>

                                </div>


                            </div>


                            <!-- ================================= -->
                            <!-- RIGHT SIDE -->
                            <!-- ================================= -->

                            <div class="col-md-5">


                                <label class="form-label">
                                    Image Preview
                                </label>


                                <div class="border rounded bg-light"
                                     style="
                                         width:100%;
                                         height:420px;
                                         display:flex;
                                         align-items:center;
                                         justify-content:center;
                                         overflow:hidden;
                                     ">


                                    <div class="text-center">

                                        <div style="
                                            font-size:60px;
                                            margin-bottom:10px;
                                        ">
                                            🖼️
                                        </div>

                                        <p class="text-muted mb-0">
                                            Image preview will appear here
                                        </p>

                                    </div>


                                </div>


                            </div>


                        </div>


                        <!-- DIVIDER -->

                        <hr class="my-4" />


                        <!-- BUTTONS -->

                        <div class="d-flex justify-content-between">


                            <!-- CANCEL -->

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                CANCEL
                            </a>


                            <!-- SAVE -->

                            <button type="submit"
                                    class="btn btn-dark">
                                SAVE ITEM
                            </button>


                        </div>


                    </form>


                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}