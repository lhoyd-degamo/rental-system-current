@model List<CRUD.Models.Item>

<div class="container-fluid py-4">

    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="btn btn-outline-secondary mb-3">
        Back
    </a>


    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

        <div>

            <h2>
                Items
            </h2>

            <p class="text-muted mb-0">
                Manage rental items and inventory.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-dark">
            ADD ITEM
        </a>

    </div>


    <!-- SEARCH -->

    <form asp-action="Index"
          method="get"
          class="bg-white border p-3 mb-4">

        <div class="row g-2">

            <div class="col-md-5">

                <input type="text"
                       name="searchString"
                       class="form-control"
                       placeholder="Search item name or description..."
                       value="@Context.Request.Query["searchString"]" />

            </div>


            <div class="col-md-4">

                <select name="categoryId"
                        class="form-select">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Value">
                            @category.Text
                        </option>
                    }

                </select>

            </div>


            <div class="col-md-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-dark">
                    FILTER
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    CLEAR
                </a>

            </div>

        </div>

    </form>


    <!-- TABLE -->

    <div class="table-responsive bg-white border">

        <table class="table table-bordered table-hover mb-0 align-middle">

            <thead class="table-light">

                <tr>

                    <th>
                        Image
                    </th>

                    <th>
                        Code
                    </th>

                    <th>
                        Name
                    </th>

                    <th>
                        Category
                    </th>

                    <th>
                        Size
                    </th>

                    <th>
                        Price
                    </th>

                    <th>
                        Quantity
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="9"
                            class="text-center text-muted py-5">

                            No items found.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <!-- IMAGE -->

                            <td class="text-center">

                                @if (!string.IsNullOrWhiteSpace(
                                    item.ImagePath))
                                {
                                    <img src="@item.ImagePath"
                                         alt="@item.ItemName"
                                         style="
                                            width:70px;
                                            height:80px;
                                            object-fit:cover;
                                            border-radius:6px;
                                            border:1px solid #ddd;" />
                                }
                                else
                                {
                                    <div style="
                                        width:70px;
                                        height:80px;
                                        background:#f5f5f5;
                                        border:1px solid #ddd;
                                        border-radius:6px;
                                        display:flex;
                                        align-items:center;
                                        justify-content:center;">

                                        <small class="text-muted">
                                            No Image
                                        </small>

                                    </div>
                                }

                            </td>


                            <td>
                                @item.ItemCode
                            </td>


                            <td>
                                @item.ItemName
                            </td>


                            <td>
                                @item.Category?.CatName
                            </td>


                            <td>
                                @item.Size
                            </td>


                            <td>
                                ₱@item.Amount.ToString("N2")
                            </td>


                            <td>
                                @item.Quantity
                            </td>


                            <td>

                                @if (item.Status == "Available")
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                }

                            </td>


                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.ItemID"
                                   class="btn btn-sm btn-outline-dark">
                                    Edit
                                </a>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>