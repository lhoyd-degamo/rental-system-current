@model CRUD.Models.Item

<h2>Delete Item</h2>

<h4>Are you sure you want to delete this item?</h4>

<hr />


<p><strong>ID:</strong> @Model.ItemID</p>
<p><strong>Item Code:</strong> @Model.ItemCode</p>
<p><strong>Name:</strong> @Model.ItemName</p>
<p><strong>Description:</strong> @Model.Description</p>

<p><strong>Amount:</strong> @Model.Amount</p>

<p><strong>Category ID:</strong> @Model.Category</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="ItemID" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>